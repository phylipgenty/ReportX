# Copy to backend/.env and adjust. All settings are optional.

# REPORTX_APP_NAME=ReportX
# REPORTX_ORGANISATION_NAME=FMDQ Group
# REPORTX_CURRENCY=NGN
# REPORTX_CURRENCY_SYMBOL=₦

# Storage
# REPORTX_DATABASE_PATH=data/reportx.db
# REPORTX_UPLOAD_DIR=uploads

# Project ID format: PRJ-00001 (README §53.5)
# REPORTX_PROJECT_ID_PREFIX=PRJ
# REPORTX_PROJECT_ID_WIDTH=5

# Completion % strategy: equal | weighted (README §53.1 — awaiting business confirmation)
# REPORTX_COMPLETION_STRATEGY=equal

# Attachments (README §53.4 — accepted types awaiting confirmation)
# REPORTX_UPLOAD_EXTENSIONS=.pdf,.docx,.xlsx,.pptx,.png,.jpg,.jpeg
# REPORTX_UPLOAD_MAX_MB=25

# Load app/seed/demo_projects.json into an empty database on startup
# REPORTX_SEED_DEMO_PROJECTS=false

# Sign-in (README §43). The Admin area can also change the app name,
# organisation, currency, Project ID format and attachment rules at runtime.
# REPORTX_SESSION_HOURS=12
# REPORTX_SESSION_COOKIE_SECURE=false   # set true when served over HTTPS
# REPORTX_MIN_PASSWORD_LENGTH=10
# REPORTX_LOGIN_MAX_ATTEMPTS=5
# REPORTX_LOGIN_LOCKOUT_MINUTES=15
